# VeilStack Root Configuration
# Copy this file to .env and fill in values

# ====================================
# Blockchain Configuration
# ====================================
# Active chain: filecoin or ethereum
ACTIVE_CHAIN=filecoin

# Filecoin Calibration Testnet
FIL_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
FIL_CONTRACT_ADDRESS=0x686d5d622298cfca880168Badf83ac3F71C4a33A

# Ethereum Sepolia Testnet
# ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# ETH_CONTRACT_ADDRESS=

# ====================================
# Wallet Configuration
# ====================================
# Deployer private key (for on-chain status reporting)
# When set, the scheduler registers nodes and reports status on-chain.
# When empty, the scheduler runs in read-only mode (events only, no transactions).
# PRIVATE_KEY=0x...

# Mnemonic phrase (for truffle/deploy scripts)
# MNEMONIC=your twelve word seed phrase

# ====================================
# Server Configuration
# ====================================
# P2P cluster port
PORT=5000

# Health check API port
WEB_PORT=5001

# Node environment (development, production, test)
NODE_ENV=development
