# ====================================
# Canteen Backend Configuration
# ====================================

# Deployer private key (for deploy.js and on-chain status reporting)
# When set, the scheduler registers the node and reports container status on-chain.
# When empty, the scheduler runs in read-only mode (events only, no transactions).
# PRIVATE_KEY=0x...

# Mnemonic (for local Ganache development only — never use in production)
# MNEMONIC=your twelve word mnemonic phrase here

# Active blockchain network (ethereum or filecoin)
ACTIVE_CHAIN=filecoin

# ====================================
# Ethereum Configuration
# ====================================
# Sepolia Testnet (Recommended for testing)
# REQUIRED for truffle deploy operations
ETH_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ETH_CONTRACT_ADDRESS=
ETH_CHAIN_ID=11155111

# Ethereum Mainnet (Production - use with caution)
# ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
# ETH_CONTRACT_ADDRESS=
# ETH_CHAIN_ID=1

# ====================================
# Filecoin Configuration
# ====================================
# Filecoin Calibration Testnet (Recommended for testing)
FIL_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
FIL_CONTRACT_ADDRESS=0x686d5d622298cfca880168Badf83ac3F71C4a33A
FIL_CHAIN_ID=314159

# Filecoin Mainnet (Production)
# FIL_RPC_URL=https://api.node.glif.io/rpc/v1
# FIL_CONTRACT_ADDRESS=
# FIL_CHAIN_ID=314

# ====================================
# IPFS Pinning Configuration (Pinata)
# ====================================
# Get keys from https://app.pinata.io/developers/api-keys
# PINATA_API_KEY=
# PINATA_SECRET_KEY=

# ====================================
# Server Configuration
# ====================================
# P2P cluster port
PORT=5000

# Health check API port
WEB_PORT=5001

# API key for mutating endpoints (POST/DELETE) — set to enable auth
# WEB_API_KEY=your-secret-api-key

# Node environment
NODE_ENV=development

# ====================================
# Docker Configuration
# ====================================
# Leave empty for auto-detection
# DOCKER_SOCKET=/var/run/docker.sock
